# -----------------------------------------------------------------------------
# ShopAd Platform - Development Environment Configuration (Template)
# Copy this file to .env.dev and fill in your development keys.
# DO NOT COMMIT .env.dev, .env.staging, or .env.prod TO SOURCE CONTROL!
# -----------------------------------------------------------------------------

# Active Environment
APP_ENV=dev

# Application Title
APP_NAME=Shop Ad Platform (DEV)

# Supabase Public Client Credentials (NEVER use service_role key here)
SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_dev_anon_key_here

# Google Maps Platform Android API Key
GOOGLE_MAPS_API_KEY=AIzaSy_DEV_GOOGLE_MAPS_KEY_HERE

# API Base URL for local mock/backend services
API_BASE_URL=http://10.0.2.2:3000

# Diagnostic Logging
ENABLE_VERBOSE_LOGGING=true
